{
	"name": "ezjot",
	"version": "2.1.0",
	"private": true,
	"type": "module",
	"module": "backend/index.js",
	"scripts": {
		"install:frontend": "cd frontend && bun install",
		"install": "bun install --ignore-scripts && bun run install:frontend",
		"dev:backend": "bun --watch backend/index.js",
		"dev:frontend": "cd frontend && bun run dev",
		"dev": "conc \"bun dev:frontend\" \"bun dev:backend\"",
		"build:client": "cd frontend && bun run build",
		"test": "PORT=0 bun test backend/tests/",
		"test:watch": "PORT=0 bun test --watch backend/tests/",
		"start": "NODE_ENV=production bun backend/index.js"
	},
	"dependencies": {
		"@elysiajs/openapi": "^1.4.15",
		"@elysiajs/static": "^1.4.10",
		"deadslog": "^1.3.1",
		"elysia": "^1.4.29"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"concurrently": "^9.2.4"
	}
}
