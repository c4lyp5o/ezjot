{
	"name": "ezjot",
	"version": "2.1.0",
	"private": true,
	"type": "module",
	"module": "backend/index.js",
	"scripts": {
		"install-server": "bun install",
		"install-client": "cd client && bun install",
		"install-deps": "bun run install-server && bun run install-client",
		"dev-server": "bun --watch backend/index.js",
		"dev-client": "cd client && bun run dev",
		"dev": "conc \"bun dev-client\" \"bun dev-server\"",
		"build-client": "cd client && bun run build",
		"test": "PORT=0 bun test backend/tests/",
		"test:watch": "PORT=0 bun test --watch backend/tests/",
		"start": "NODE_ENV=production bun backend/index.js"
	},
	"dependencies": {
		"@elysiajs/openapi": "^1.4.15",
		"@elysiajs/static": "^1.4.10",
		"deadslog": "^1.3.1",
		"elysia": "^1.4.29"
	},
	"devDependencies": {
		"concurrently": "^9.1.2"
	}
}
